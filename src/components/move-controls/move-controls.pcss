.move-controls {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  grid-template-areas:
    ". up ."
    "left . right"
    ". down .";
  gap: 8px;
  width: 280px;
  margin: 12px 0;
}

.move-controls__button {
  cursor: pointer;
}

.move-controls__button--up {
  grid-area: up;
}

.move-controls__button--left {
  grid-area: left;
}

.move-controls__button--right {
  grid-area: right;
}

.move-controls__button--down {
  grid-area: down;
}

.move-controls__button:disabled {
  cursor: not-allowed;
  opacity: 0.35;
}
