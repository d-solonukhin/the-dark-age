.minimap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.minimap__map {
  display: grid;
  gap: 4px;
  width: fit-content;
  margin: 16px 0;
}

.minimap__row {
  display: grid;
  grid-template-columns: repeat(8, 28px);
  gap: 4px;
}

.minimap__cell {
  display: grid;
  width: 28px;
  height: 28px;

  color: #bbb;
  font-family: monospace;

  border: 1px solid #ddd;
  place-items: center;
}

.minimap__cell.room {
  color: #888;
  background: #f3f0ea;
  border-color: #c9c1b3;
}

.minimap__cell.hero {
  color: #fff;
  background: #2b2b2b;
  border-color: #2b2b2b;
}

.minimap__wrapper {
  text-align: center;
}

.minimap__location {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 16px;
}

.minimap__room {
  margin-top: 0;
  margin-bottom: 0;
  font-size: 24px;
}
